digraph ConSub {
  graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=0.75, bgcolor="white", pad=0.25, fontname="Arial", label="ConSub — modelo ER implementado", labelloc=t, fontsize=22];
  node [shape=record, style="rounded,filled", fillcolor="#f6faf7", color="#4d7961", penwidth=1.4, fontname="Arial", fontsize=10, margin="0.12,0.08"];
  edge [color="#537f67", penwidth=1.3, arrowsize=0.75, fontname="Arial", fontsize=9];

  especialidades [label="{especialidades|PK id\lnome\lslug\l}"];
  cidades [label="{cidades|PK id\lnome\luf\lslug\l}"];
  unidades_saude [label="{unidades_saude|PK id\lFK cidade_id\lnome\ltipo\l}"];
  profissionais_saude [label="{profissionais_saude|PK id\lnome\l}"];
  consultas [label="{consultas|PK id\lFK especialidade_id\lFK unidade_id\lFK profissional_id\ldata_hora\lvagas_disponiveis\lurgencia · status\l}"];
  capacidade_transporte [label="{capacidade_transporte|PK data\lcapacidade\locupados\l}"];
  pacientes [label="{pacientes|PK id\lFK owner_id → auth.users\lnome_completo · cpf\ldata_nascimento · telefone\le-mail · CNS · responsável\lcreated_at\l}"];
  inscricoes_fila [label="{inscricoes_fila|PK id\lFK owner_id → auth.users\lFK paciente_id\lFK especialidade_id\lFK cidade_id\lFK unidade_referencia_id (nulo)\lurgencia · descricao · aceite\lstatus · created_at\l}"];
  solicitacoes_consulta [label="{solicitacoes_consulta|PK id\lFK owner_id → auth.users\lFK consulta_id\lstatus · created_at\l}"];
  solicitacoes_transporte [label="{solicitacoes_transporte|PK id\lFK owner_id → auth.users\lFK solicitacao_consulta_id (UK)\ldata · ponto_embarque\larea_rural · comunidade_rural\lpassageiros · created_at\l}"];

  cidades -> unidades_saude [label="1:N"];
  especialidades -> consultas [label="1:N"];
  unidades_saude -> consultas [label="1:N"];
  profissionais_saude -> consultas [label="1:N"];
  pacientes -> inscricoes_fila [label="1:N"];
  especialidades -> inscricoes_fila [label="1:N"];
  cidades -> inscricoes_fila [label="1:N"];
  unidades_saude -> inscricoes_fila [label="0..1:N"];
  consultas -> solicitacoes_consulta [label="1:N"];
  solicitacoes_consulta -> solicitacoes_transporte [label="1:0..1"];

  { rank=same; especialidades; cidades; capacidade_transporte; pacientes; }
  { rank=same; unidades_saude; profissionais_saude; inscricoes_fila; }
  { rank=same; consultas; solicitacoes_consulta; solicitacoes_transporte; }
  capacidade_transporte -> consultas [style=invis];
}
